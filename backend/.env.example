# Em desenvolvimento, mantenha o endereço do Vite.
# Em produção, substitua pelo domínio público do Static Site no Render.
ALLOWED_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MINUTE=60

# Inteligência online opcional. Nunca exponha estas chaves no frontend ou no Git.
# Google Web Risk: reputação de URLs suspeitas (exige projeto Google Cloud e API key).
WEBRISK_API_KEY=

# Google Fact Check Tools: busca de checagens publicadas (exige API key).
FACTCHECK_API_KEY=

# Consulta de senha por k-anonimato à base Pwned Passwords. Envia só os 5
# primeiros caracteres de um hash SHA-1, nunca a senha. Mantenha false até
# informar os visitantes sobre essa verificação opcional.
PWNED_PASSWORDS_ENABLED=false
